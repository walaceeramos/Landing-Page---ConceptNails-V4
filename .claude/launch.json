{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "start"],
      "port": 5000
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--bind", "127.0.0.1"],
      "port": 8080
    },
    {
      "name": "netlify",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "netlify-cli@17", "dev", "--offline", "--dir", ".", "--port", "8888", "--no-open"],
      "port": 8888
    }
  ]
}
